datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String                @id @default(uuid())
  name            String?               @default("Guest User")
  email           String?               @unique
  password        String?
  username        String?               @default("guest")
  title           String?               @default("Product Designer & Engineer")
  avatar          String?               @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80")
  isGuest         Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  boards          Board[]
  projects        Project[]
  ownedWorkspaces Workspace[]           @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  taskAssignments TaskMember[]
  sentInvitations WorkspaceInvitation[] @relation("SentInvitations")
  notifications   Notification[]
}

model Workspace {
  id          String                @id @default(uuid())
  name        String                @default("Personal Workspace")
  description String?               @default("")
  ownerId     String
  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  boards      Board[]
  projects    Project[]
  tasks       Task[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER, GUEST
  status      String    @default("ACTIVE") // ACTIVE, REMOVED
  joinedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model TaskMember {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // ADMIN, MEMBER, GUEST
  token       String    @unique
  status      String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([email])
  @@index([token])
}

model Board {
  id          String     @id @default(uuid())
  name        String     @default("Tasks")
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String?    @default("")
  priority    String     @default("Medium") // High, Medium, Low, Urgent
  leadName    String     @default("")
  leadAvatar  String?    @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80")
  dueDate     String?    @default("12 Sep 2026")
  status      String     @default("In Progress") // Planning, In Progress, Released
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Column {
  id        String   @id @default(uuid())
  name      String
  color     String?  @default("#49C4E5")
  position  Int      @default(0)
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id             String       @id @default(uuid())
  title          String
  description    String?      @default("")
  status         String       @default("To Do")
  priority       String       @default("Medium") // Urgent, High, Medium, Low, No Priority
  dueDate        String?      @default("29 Jul")
  labels         String?      @default("Deployment")
  assigneeName   String?      @default("")
  assigneeAvatar String?      @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80")
  resources      String?      @default("[]") // JSON string of [{ name, url }]
  team           String?      @default("")
  reporter       String?      @default("")
  isLocked       Boolean      @default(false)
  position       Int          @default(0)
  columnId       String
  column         Column       @relation(fields: [columnId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspaceId    String?
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskMembers    TaskMember[]
  subtasks       Subtask[]
  comments       Comment[]
  activities     Activity[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Subtask {
  id             String   @id @default(uuid())
  title          String
  priority       String?  @default("Medium")
  assigneeName   String?  @default("")
  assigneeAvatar String?  @default("")
  dueDate        String?  @default("12 Sep 2026")
  isCompleted    Boolean  @default(false)
  taskId         String
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Comment {
  id           String    @id @default(uuid())
  authorName   String    @default("You")
  authorAvatar String?   @default("https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80")
  content      String
  taskId       String
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("CommentReplies")
  createdAt    DateTime  @default(now())

  @@index([taskId])
  @@index([parentId])
}

model Activity {
  id          String   @id @default(uuid())
  type        String   @default("priority") // priority, status, comment, create, member, date, resource, subtask
  description String
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("info") // task_assigned, comment_reply, workspace_invite, general
  title     String
  message   String
  link      String?  @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
